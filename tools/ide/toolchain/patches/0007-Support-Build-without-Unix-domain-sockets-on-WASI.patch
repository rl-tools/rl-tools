From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RLtools <rl-tools@localhost>
Date: Sun, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH 7/8] [Support] Build without Unix domain sockets on WASI

WASI preview1 has no socket creation: wasi-libc declares neither socket()
nor bind(), listen() or connect(), and sockaddr_un has no path. Compile
raw_socket_stream out on WASI, the way zOSLibFunctions.cpp is compiled
out elsewhere; nothing in a WASI build uses it.
---
 llvm/lib/Support/raw_socket_stream.cpp | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/llvm/lib/Support/raw_socket_stream.cpp b/llvm/lib/Support/raw_socket_stream.cpp
index f71631730..a2d6375c4 100644
--- a/llvm/lib/Support/raw_socket_stream.cpp
+++ b/llvm/lib/Support/raw_socket_stream.cpp
@@ -41,6 +41,11 @@
 
 using namespace llvm;
 
+#if defined(__wasi__)
+// WASI preview1 cannot create sockets: socket(), bind(), listen() and
+// connect() do not exist, so the stream has no implementation there.
+#else
+
 #ifdef _WIN32
 WSABalancer::WSABalancer() {
   WSADATA WsaData;
@@ -356,3 +361,5 @@ ssize_t raw_socket_stream::read(char *Ptr, size_t Size,
   }
   return raw_fd_stream::read(Ptr, Size);
 }
+
+#endif // !__wasi__
