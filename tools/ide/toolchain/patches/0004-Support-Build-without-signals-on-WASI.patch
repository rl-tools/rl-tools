From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RLtools <rl-tools@localhost>
Date: Sun, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH 4/8] [Support] Build without signals on WASI

WASI has no signals: nothing can be delivered, sigaction, sigprocmask,
sigaltstack, alarm and kill do not exist, and a trap ends the program.
wasi-libc's signal emulation only provides signal() and raise().

Give the signal entry points a WASI implementation in place of
Unix/Signals.inc that keeps the bookkeeping the rest of LLVM drives
explicitly (files to remove on a fatal error, handler callbacks) and
makes everything signal-specific a no-op; install no handlers in
CrashRecoveryContext and only use setjmp there when HAVE_SETJMP says it
exists; do not arm the Watchdog; close file descriptors without masking
signals; and treat lock owners as running since there is no kill to
probe them with.
---
 llvm/lib/Support/CrashRecoveryContext.cpp | 22 +++++++-
 llvm/lib/Support/LockFileManager.cpp      |  2 +-
 llvm/lib/Support/Signals.cpp              | 64 +++++++++++++++++++++--
 llvm/lib/Support/Unix/Process.inc         |  7 +++
 llvm/lib/Support/Unix/Watchdog.inc        |  4 +-
 5 files changed, 92 insertions(+), 7 deletions(-)

diff --git a/llvm/lib/Support/CrashRecoveryContext.cpp b/llvm/lib/Support/CrashRecoveryContext.cpp
index 1ba0c2383..0b21f9a9a 100644
--- a/llvm/lib/Support/CrashRecoveryContext.cpp
+++ b/llvm/lib/Support/CrashRecoveryContext.cpp
@@ -7,6 +7,7 @@
 //===----------------------------------------------------------------------===//
 
 #include "llvm/Support/CrashRecoveryContext.h"
+#include "llvm/Config/config.h"
 #include "llvm/Config/llvm-config.h"
 #include "llvm/Support/ErrorHandling.h"
 #include "llvm/Support/ExitCodes.h"
@@ -14,7 +15,9 @@
 #include "llvm/Support/thread.h"
 #include <cassert>
 #include <mutex>
+#if HAVE_SETJMP
 #include <setjmp.h>
+#endif
 
 using namespace llvm;
 
@@ -31,7 +34,9 @@ struct CrashRecoveryContextImpl {
   const CrashRecoveryContextImpl *Next;
 
   CrashRecoveryContext *CRC;
+#if HAVE_SETJMP
   ::jmp_buf JumpBuffer;
+#endif
   volatile unsigned Failed : 1;
   unsigned SwitchedThread : 1;
   unsigned ValidJumpBuffer : 1;
@@ -72,9 +77,11 @@ public:
 
     CRC->RetCode = RetCode;
 
+#if HAVE_SETJMP
     // Jump back to the RunSafely we were called under.
     if (ValidJumpBuffer)
       longjmp(JumpBuffer, 1);
+#endif
 
     // Otherwise let the caller decide of the outcome of the crash. Currently
     // this occurs when using SEH on Windows with MSVC or clang-cl.
@@ -329,7 +336,18 @@ static void uninstallExceptionOrSignalHandlers() {
   }
 }
 
-#else // !_WIN32
+#elif defined(__wasi__)
+
+// WASI has no signals and its traps are fatal: there are no handlers to
+// install and no crash to recover from. raise() below comes from wasi-libc's
+// signal emulation.
+
+#include <signal.h>
+
+static void installExceptionOrSignalHandlers() {}
+static void uninstallExceptionOrSignalHandlers() {}
+
+#else // !_WIN32 && !__wasi__
 
 // Generic POSIX implementation.
 //
@@ -417,10 +435,12 @@ bool CrashRecoveryContext::RunSafely(function_ref<void()> Fn) {
     CrashRecoveryContextImpl *CRCI = new CrashRecoveryContextImpl(this);
     Impl = CRCI;
 
+#if HAVE_SETJMP
     CRCI->ValidJumpBuffer = true;
     if (setjmp(CRCI->JumpBuffer) != 0) {
       return false;
     }
+#endif
   }
 
   Fn();
diff --git a/llvm/lib/Support/LockFileManager.cpp b/llvm/lib/Support/LockFileManager.cpp
index 0891ef980..8087f8e24 100644
--- a/llvm/lib/Support/LockFileManager.cpp
+++ b/llvm/lib/Support/LockFileManager.cpp
@@ -112,7 +112,7 @@ static std::error_code getHostID(SmallVectorImpl<char> &HostID) {
 }
 
 bool LockFileManager::processStillExecuting(StringRef HostID, int PID) {
-#if LLVM_ON_UNIX && !defined(__ANDROID__)
+#if LLVM_ON_UNIX && !defined(__ANDROID__) && !defined(__wasi__)
   SmallString<256> StoredHostID;
   if (getHostID(StoredHostID))
     return true; // Conservatively assume it's executing on error.
diff --git a/llvm/lib/Support/Signals.cpp b/llvm/lib/Support/Signals.cpp
index f160a135f..eabf0d2be 100644
--- a/llvm/lib/Support/Signals.cpp
+++ b/llvm/lib/Support/Signals.cpp
@@ -15,6 +15,7 @@
 
 #include "DebugOptions.h"
 
+#include "llvm/ADT/STLExtras.h"
 #include "llvm/ADT/StringRef.h"
 #include "llvm/Config/llvm-config.h"
 #include "llvm/Support/CommandLine.h"
@@ -32,6 +33,8 @@
 #include "llvm/Support/raw_ostream.h"
 #include <array>
 #include <cmath>
+#include <string>
+#include <vector>
 
 //===----------------------------------------------------------------------===//
 //=== WARNING: Implementation here must contain only TRULY operating system
@@ -353,9 +356,64 @@ static bool printMarkupStackTrace(StringRef Argv0, void **StackTrace, int Depth,
 }
 
 // Include the platform-specific parts of this class.
-#ifdef LLVM_ON_UNIX
+#if defined(__wasi__)
+// WASI has no signals: nothing is ever delivered, so there are no handlers to
+// register, no stack traces to print and nothing to symbolize. What remains is
+// the bookkeeping the rest of LLVM drives explicitly: files registered for
+// removal on a fatal error are removed by RunInterruptHandlers, and callbacks
+// added with AddSignalHandler run through RunSignalHandlers.
+static std::vector<std::string> &filesToRemove() {
+  static std::vector<std::string> Files;
+  return Files;
+}
+
+static bool findModulesAndOffsets(void **StackTrace, int Depth,
+                                  const char **Modules, intptr_t *Offsets,
+                                  const char *MainExecutableName,
+                                  StringSaver &StrPool) {
+  return false;
+}
+
+static bool printMarkupContext(raw_ostream &OS,
+                               const char *MainExecutableName) {
+  return false;
+}
+
+void sys::RunInterruptHandlers() {
+  for (const std::string &File : filesToRemove())
+    sys::fs::remove(File);
+  filesToRemove().clear();
+}
+
+void sys::CleanupOnSignal(uintptr_t Context) {
+  RunInterruptHandlers();
+  RunSignalHandlers();
+}
+
+bool sys::RemoveFileOnSignal(StringRef Filename, std::string *ErrMsg) {
+  filesToRemove().push_back(Filename.str());
+  return false;
+}
+
+void sys::DontRemoveFileOnSignal(StringRef Filename) {
+  llvm::erase(filesToRemove(), Filename.str());
+}
+
+void sys::AddSignalHandler(sys::SignalHandlerCallback FnPtr, void *Cookie) {
+  insertSignalHandler(FnPtr, Cookie);
+}
+
+void sys::PrintStackTraceOnErrorSignal(StringRef Argv0,
+                                       bool DisableCrashReporting) {}
+void sys::DisableSystemDialogsOnCrash() {}
+void sys::PrintStackTrace(raw_ostream &OS, int Depth) {}
+void sys::SetInterruptFunction(void (*IF)()) {}
+void sys::SetInfoSignalFunction(void (*Handler)()) {}
+void sys::SetOneShotPipeSignalFunction(void (*Handler)()) {}
+void sys::DefaultOneShotPipeSignalHandler() {}
+void sys::unregisterHandlers() {}
+#elif defined(LLVM_ON_UNIX)
 #include "Unix/Signals.inc"
-#endif
-#ifdef _WIN32
+#elif defined(_WIN32)
 #include "Windows/Signals.inc"
 #endif
diff --git a/llvm/lib/Support/Unix/Process.inc b/llvm/lib/Support/Unix/Process.inc
index 2980efadc..f361eea0d 100644
--- a/llvm/lib/Support/Unix/Process.inc
+++ b/llvm/lib/Support/Unix/Process.inc
@@ -256,6 +256,12 @@ std::error_code Process::FixupStandardFileDescriptors() {
 }
 
 std::error_code Process::SafelyCloseFileDescriptor(int FD) {
+#if defined(__wasi__)
+  // WASI has no signals to block around the close.
+  if (::close(FD) < 0)
+    return errnoAsErrorCode();
+  return std::error_code();
+#else
   // Create a signal set filled with *all* signals.
   sigset_t FullSet, SavedSet;
   if (sigfillset(&FullSet) < 0 || sigfillset(&SavedSet) < 0)
@@ -288,6 +294,7 @@ std::error_code Process::SafelyCloseFileDescriptor(int FD) {
   if (ErrnoFromClose)
     return std::error_code(ErrnoFromClose, std::generic_category());
   return std::error_code(EC, std::generic_category());
+#endif
 }
 
 bool Process::StandardInIsUserInput() {
diff --git a/llvm/lib/Support/Unix/Watchdog.inc b/llvm/lib/Support/Unix/Watchdog.inc
index b33e52d88..b18f0a40c 100644
--- a/llvm/lib/Support/Unix/Watchdog.inc
+++ b/llvm/lib/Support/Unix/Watchdog.inc
@@ -19,13 +19,13 @@
 namespace llvm {
 namespace sys {
 Watchdog::Watchdog(unsigned int seconds) {
-#ifdef HAVE_UNISTD_H
+#if defined(HAVE_UNISTD_H) && !defined(__wasi__)
   alarm(seconds);
 #endif
 }
 
 Watchdog::~Watchdog() {
-#ifdef HAVE_UNISTD_H
+#if defined(HAVE_UNISTD_H) && !defined(__wasi__)
   alarm(0);
 #endif
 }
