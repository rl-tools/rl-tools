From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RLtools <rl-tools@localhost>
Date: Sun, 6 Sep 2026 00:00:00 +0000
Subject: [PATCH 5/8] [Support] Build without subprocesses on WASI

WASI has no fork, exec, wait4 or posix_spawn, no signals to interrupt a
wait with, and no sys/wait.h. Execute reports that subprocesses are
unsupported, Wait returns the same error, and the helpers only the real
implementations use are compiled out with them.
---
 llvm/lib/Support/Unix/Program.inc | 28 +++++++++++++++++++++++++++-
 llvm/lib/Support/Unix/Unix.h      |  2 ++
 2 files changed, 29 insertions(+), 1 deletion(-)

diff --git a/llvm/lib/Support/Unix/Program.inc b/llvm/lib/Support/Unix/Program.inc
index 2aaf64ae1..664cbb137 100644
--- a/llvm/lib/Support/Unix/Program.inc
+++ b/llvm/lib/Support/Unix/Program.inc
@@ -89,6 +89,22 @@ ErrorOr<std::string> sys::findProgramByName(StringRef Name,
   return errc::no_such_file_or_directory;
 }
 
+#if defined(__wasi__)
+
+// WASI has no processes: nothing can be spawned or waited for.
+static bool Execute(ProcessInfo &PI, StringRef Program,
+                    ArrayRef<StringRef> Args,
+                    std::optional<ArrayRef<StringRef>> Env,
+                    ArrayRef<std::optional<StringRef>> Redirects,
+                    unsigned MemoryLimit, std::string *ErrMsg,
+                    BitVector *AffinityMask, bool DetachProcess) {
+  if (ErrMsg)
+    *ErrMsg = "WASI does not support subprocesses";
+  return false;
+}
+
+#else
+
 static bool RedirectIO(std::optional<StringRef> Path, int FD, std::string *ErrMsg) {
   if (!Path) // Noop
     return false;
@@ -337,12 +353,14 @@ static bool Execute(ProcessInfo &PI, StringRef Program,
   return true;
 }
 
+#endif // !__wasi__
+
 namespace llvm {
 namespace sys {
 
 #if defined(_AIX)
 static pid_t(wait4)(pid_t pid, int *status, int options, struct rusage *usage);
-#elif !defined(__Fuchsia__)
+#elif !defined(__Fuchsia__) && !defined(__wasi__)
 using ::wait4;
 #endif
 
@@ -388,6 +406,13 @@ ProcessInfo llvm::sys::Wait(const ProcessInfo &PI,
                             std::string *ErrMsg,
                             std::optional<ProcessStatistics> *ProcStat,
                             bool Polling) {
+#if defined(__wasi__)
+  if (ErrMsg)
+    *ErrMsg = "WASI does not support subprocesses";
+  ProcessInfo WaitResult = PI;
+  WaitResult.ReturnCode = -2;
+  return WaitResult;
+#else
   struct sigaction Act, Old;
   assert(PI.Pid && "invalid pid to wait on, process not started?");
 
@@ -505,6 +530,7 @@ ProcessInfo llvm::sys::Wait(const ProcessInfo &PI,
     WaitResult.ReturnCode = -2;
   }
   return WaitResult;
+#endif // !__wasi__
 }
 
 std::error_code llvm::sys::ChangeStdinMode(fs::OpenFlags Flags) {
diff --git a/llvm/lib/Support/Unix/Unix.h b/llvm/lib/Support/Unix/Unix.h
index f24d52498..e7e94658c 100644
--- a/llvm/lib/Support/Unix/Unix.h
+++ b/llvm/lib/Support/Unix/Unix.h
@@ -29,7 +29,9 @@
 #include <cstring>
 #include <string>
 #include <sys/types.h>
+#if !defined(__wasi__)
 #include <sys/wait.h>
+#endif
 
 #ifdef HAVE_UNISTD_H
 #include <unistd.h>
