function(rl_tools_summary_line LABEL STATE REASON)
    if(NOT REASON STREQUAL "")
        message(STATUS "  ${LABEL}: ${STATE} (${REASON})")
    else()
        message(STATUS "  ${LABEL}: ${STATE}")
    endif()
endfunction()

function(rl_tools_summary_feature LABEL OUTPUT_VARIABLE REASON_VARIABLE DISABLE_VARIABLE)
    set(RL_TOOLS_SUMMARY_STATE OFF)
    if(${OUTPUT_VARIABLE})
        set(RL_TOOLS_SUMMARY_STATE ON)
    endif()
    set(RL_TOOLS_SUMMARY_REASON "${${REASON_VARIABLE}}")
    if(${DISABLE_VARIABLE})
        set(RL_TOOLS_SUMMARY_REASON "disabled by ${DISABLE_VARIABLE}")
    endif()
    rl_tools_summary_line("${LABEL}" "${RL_TOOLS_SUMMARY_STATE}" "${RL_TOOLS_SUMMARY_REASON}")
endfunction()

