set(GOLDEN_WASI_SDK_VERSION 34.0)
set(GOLDEN_WASMTIME_VERSION 49.0.2)
set(GOLDEN_WASI_SDK_SHA256_arm64_macos 9c59398106b417f8f14913380fdf0097a8cc0ff4af9eb3ce0065a859e88d49e9)
set(GOLDEN_WASI_SDK_SHA256_x86_64_linux b761e3a0721dbae9c09a0059e5fdb2bf917d1b4a8a7b430fb3b5aafb0984b2c4)
set(GOLDEN_WASMTIME_SHA256_arm64_macos ea5a79261caa39819b863fd850879428cf90548353e1e5cf9bcbcc4e7addf2c1)
set(GOLDEN_WASMTIME_SHA256_x86_64_linux a4d6e9e3a5a60f527cf7793d674c48930c80c2e8977995b8a275cad3254b9322)

function(rl_tools_fetch_wasm DEPENDENCIES_DIR)
    set(RL_TOOLS_WASM_UNAVAILABLE_REASON "" PARENT_SCOPE)
    cmake_host_system_information(RESULT ARCH QUERY OS_PLATFORM)
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Darwin" AND ARCH STREQUAL "arm64")
        set(PLATFORM arm64_macos)
        set(SDK_PLATFORM arm64-macos)
        set(RUNTIME_PLATFORM aarch64-macos)
    elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND ARCH STREQUAL "x86_64")
        set(PLATFORM x86_64_linux)
        set(SDK_PLATFORM x86_64-linux)
        set(RUNTIME_PLATFORM x86_64-linux)
    else()
        set(RL_TOOLS_WASM_UNAVAILABLE_REASON "only supported on macOS arm64 and Linux x86_64" PARENT_SCOPE)
        return()
    endif()
    get_filename_component(DEPENDENCIES_DIR "${DEPENDENCIES_DIR}" ABSOLUTE)
    string(REGEX REPLACE "\\..*" "" SDK_RELEASE "${GOLDEN_WASI_SDK_VERSION}")
    set(SDK "wasi-sdk-${GOLDEN_WASI_SDK_VERSION}-${SDK_PLATFORM}")
    set(RUNTIME "wasmtime-v${GOLDEN_WASMTIME_VERSION}-${RUNTIME_PLATFORM}")
    set(SDK_URL "https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${SDK_RELEASE}/${SDK}.tar.gz")
    set(RUNTIME_URL "https://github.com/bytecodealliance/wasmtime/releases/download/v${GOLDEN_WASMTIME_VERSION}/${RUNTIME}.tar.xz")
    set(SDK_HASH "${GOLDEN_WASI_SDK_SHA256_${PLATFORM}}")
    set(RUNTIME_HASH "${GOLDEN_WASMTIME_SHA256_${PLATFORM}}")
    foreach(TOOL SDK RUNTIME)
        set(ARCHIVE "${DEPENDENCIES_DIR}/downloads/${${TOOL}}.archive")
        if(NOT IS_DIRECTORY "${DEPENDENCIES_DIR}/${${TOOL}}")
            if(RL_TOOLS_OFFLINE_BUILD AND NOT EXISTS "${ARCHIVE}")
                set(RL_TOOLS_WASM_UNAVAILABLE_REASON "${${TOOL}} is not cached (offline)" PARENT_SCOPE)
                return()
            endif()
            file(MAKE_DIRECTORY "${DEPENDENCIES_DIR}/downloads")
            if(RL_TOOLS_OFFLINE_BUILD)
                file(SHA256 "${ARCHIVE}" HASH)
                if(NOT HASH STREQUAL "${${TOOL}_HASH}")
                    message(FATAL_ERROR "Checksum mismatch: ${ARCHIVE}")
                endif()
            else()
                message(STATUS "Fetching ${${TOOL}}")
                file(DOWNLOAD "${${TOOL}_URL}" "${ARCHIVE}" EXPECTED_HASH "SHA256=${${TOOL}_HASH}" TLS_VERIFY ON)
            endif()
            set(EXTRACT_DIR "${DEPENDENCIES_DIR}/${${TOOL}}.extract")
            file(REMOVE_RECURSE "${EXTRACT_DIR}")
            file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${EXTRACT_DIR}")
            file(RENAME "${EXTRACT_DIR}/${${TOOL}}" "${DEPENDENCIES_DIR}/${${TOOL}}")
            file(REMOVE_RECURSE "${EXTRACT_DIR}")
        endif()
    endforeach()
    set(WASI_SDK_PREFIX "${DEPENDENCIES_DIR}/${SDK}" PARENT_SCOPE)
    set(RL_TOOLS_WASMTIME "${DEPENDENCIES_DIR}/${RUNTIME}/wasmtime" PARENT_SCOPE)
endfunction()
