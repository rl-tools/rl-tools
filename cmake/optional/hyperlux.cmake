# HyperLux backend dispatch. AUTO probes availability in preference order
# OPTIX > METAL > VULKAN > WEBGPU > GENERIC; an explicitly selected backend is hard-required.
# All backends need the fetched Assimp sources.
if(NOT RL_TOOLS_DISABLE_HYPERLUX)
    set(RL_TOOLS_HYPERLUX_BACKENDS OPTIX METAL VULKAN WEBGPU GENERIC)
    if(NOT RL_TOOLS_HYPERLUX_BACKEND STREQUAL "AUTO" AND NOT RL_TOOLS_HYPERLUX_BACKEND IN_LIST RL_TOOLS_HYPERLUX_BACKENDS)
        message(FATAL_ERROR "Invalid RL_TOOLS_HYPERLUX_BACKEND: ${RL_TOOLS_HYPERLUX_BACKEND} (AUTO|OPTIX|METAL|VULKAN|WEBGPU|GENERIC)")
    endif()
    include(cmake/optional/assimp.cmake)
    if(NOT TARGET assimp::assimp)
        if(RL_TOOLS_HYPERLUX_BACKEND STREQUAL "AUTO")
            set(RL_TOOLS_SUMMARY_HYPERLUX_REASON "Assimp archive not cached (offline)")
        else()
            message(FATAL_ERROR "RLtools HyperLux backend ${RL_TOOLS_HYPERLUX_BACKEND} requested but Assimp archive is not cached (offline)")
        endif()
    else()
        set(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED ${RL_TOOLS_HYPERLUX_BACKEND})
        if(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "AUTO")
            set(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED "GENERIC")
            set(RL_TOOLS_HYPERLUX_OPTIX_UNAVAILABLE_REASON "")
            if(RL_TOOLS_HYPERLUX_DISABLE_OPTIX)
                set(RL_TOOLS_HYPERLUX_OPTIX_UNAVAILABLE_REASON "disabled by RL_TOOLS_HYPERLUX_DISABLE_OPTIX")
            elseif(WIN32)
                set(RL_TOOLS_HYPERLUX_OPTIX_UNAVAILABLE_REASON "not supported on Windows")
            elseif(NOT RL_TOOLS_BACKEND_ENABLE_CUDA)
                set(RL_TOOLS_HYPERLUX_OPTIX_UNAVAILABLE_REASON "CUDA unavailable")
            elseif(NOT ((GIT_FOUND AND NOT RL_TOOLS_OFFLINE_BUILD) OR EXISTS "${FETCHCONTENT_BASE_DIR}/owl-src"))
                set(RL_TOOLS_HYPERLUX_OPTIX_UNAVAILABLE_REASON "cannot fetch OWL (offline/no git)")
            endif()

            set(RL_TOOLS_HYPERLUX_METAL_UNAVAILABLE_REASON "")
            if(RL_TOOLS_HYPERLUX_DISABLE_METAL)
                set(RL_TOOLS_HYPERLUX_METAL_UNAVAILABLE_REASON "disabled by RL_TOOLS_HYPERLUX_DISABLE_METAL")
            elseif(NOT APPLE)
                set(RL_TOOLS_HYPERLUX_METAL_UNAVAILABLE_REASON "not on macOS")
            else()
                find_library(RL_TOOLS_METAL_FRAMEWORK Metal)
                find_library(RL_TOOLS_FOUNDATION_FRAMEWORK Foundation)
                find_library(RL_TOOLS_QUARTZCORE_FRAMEWORK QuartzCore)
                if(NOT (RL_TOOLS_METAL_FRAMEWORK AND RL_TOOLS_FOUNDATION_FRAMEWORK AND RL_TOOLS_QUARTZCORE_FRAMEWORK))
                    set(RL_TOOLS_HYPERLUX_METAL_UNAVAILABLE_REASON "Metal/Foundation/QuartzCore frameworks not found")
                endif()
            endif()

            set(RL_TOOLS_HYPERLUX_VULKAN_UNAVAILABLE_REASON "")
            if(RL_TOOLS_HYPERLUX_DISABLE_VULKAN)
                set(RL_TOOLS_HYPERLUX_VULKAN_UNAVAILABLE_REASON "disabled by RL_TOOLS_HYPERLUX_DISABLE_VULKAN")
            else()
                find_package(Vulkan QUIET COMPONENTS glslangValidator)
                if(NOT Vulkan_FOUND OR NOT Vulkan_glslangValidator_FOUND)
                    set(RL_TOOLS_HYPERLUX_VULKAN_UNAVAILABLE_REASON "Vulkan/glslangValidator not found (e.g. apt install libvulkan-dev glslang-tools)")
                endif()
            endif()

            set(RL_TOOLS_HYPERLUX_WEBGPU_UNAVAILABLE_REASON "")
            if(RL_TOOLS_HYPERLUX_DISABLE_WEBGPU)
                set(RL_TOOLS_HYPERLUX_WEBGPU_UNAVAILABLE_REASON "disabled by RL_TOOLS_HYPERLUX_DISABLE_WEBGPU")
            elseif(NOT ((CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64") OR (CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")))
                set(RL_TOOLS_HYPERLUX_WEBGPU_UNAVAILABLE_REASON "only wired up on linux-x86_64 and macos-arm64")
            elseif(RL_TOOLS_OFFLINE_BUILD AND NOT EXISTS "${FETCHCONTENT_BASE_DIR}/wgpu_native-src")
                set(RL_TOOLS_HYPERLUX_WEBGPU_UNAVAILABLE_REASON "cannot fetch wgpu-native (offline)")
            endif()

            # platform-inapplicable candidates are not worth reporting in the summary
            set(RL_TOOLS_HYPERLUX_PLATFORM_REASONS "not supported on Windows" "not on macOS" "only wired up on linux-x86_64 and macos-arm64")
            set(RL_TOOLS_HYPERLUX_SKIP_NOTES "")
            foreach(RL_TOOLS_HYPERLUX_CANDIDATE OPTIX METAL VULKAN WEBGPU)
                if(RL_TOOLS_HYPERLUX_${RL_TOOLS_HYPERLUX_CANDIDATE}_UNAVAILABLE_REASON STREQUAL "")
                    set(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED ${RL_TOOLS_HYPERLUX_CANDIDATE})
                    break()
                else()
                    message(VERBOSE "RLtools HyperLux backend candidate ${RL_TOOLS_HYPERLUX_CANDIDATE} skipped: ${RL_TOOLS_HYPERLUX_${RL_TOOLS_HYPERLUX_CANDIDATE}_UNAVAILABLE_REASON}")
                    if(NOT RL_TOOLS_HYPERLUX_${RL_TOOLS_HYPERLUX_CANDIDATE}_UNAVAILABLE_REASON IN_LIST RL_TOOLS_HYPERLUX_PLATFORM_REASONS)
                        list(APPEND RL_TOOLS_HYPERLUX_SKIP_NOTES "${RL_TOOLS_HYPERLUX_CANDIDATE}: ${RL_TOOLS_HYPERLUX_${RL_TOOLS_HYPERLUX_CANDIDATE}_UNAVAILABLE_REASON}")
                    endif()
                endif()
            endforeach()
            set(RL_TOOLS_SUMMARY_HYPERLUX_REASON "${RL_TOOLS_HYPERLUX_BACKEND_RESOLVED}, auto-selected")
            if(RL_TOOLS_HYPERLUX_SKIP_NOTES)
                list(JOIN RL_TOOLS_HYPERLUX_SKIP_NOTES "; " RL_TOOLS_HYPERLUX_SKIP_NOTES_JOINED)
                string(APPEND RL_TOOLS_SUMMARY_HYPERLUX_REASON " (skipped ${RL_TOOLS_HYPERLUX_SKIP_NOTES_JOINED})")
            endif()
        else()
            if(RL_TOOLS_HYPERLUX_DISABLE_${RL_TOOLS_HYPERLUX_BACKEND_RESOLVED})
                message(FATAL_ERROR "RL_TOOLS_HYPERLUX_BACKEND=${RL_TOOLS_HYPERLUX_BACKEND_RESOLVED} conflicts with RL_TOOLS_HYPERLUX_DISABLE_${RL_TOOLS_HYPERLUX_BACKEND_RESOLVED}=ON")
            endif()
            set(RL_TOOLS_SUMMARY_HYPERLUX_REASON "${RL_TOOLS_HYPERLUX_BACKEND_RESOLVED}, explicitly selected")
        endif()
        if(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "METAL")
            include(cmake/optional/metal.cmake)
        elseif(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "OPTIX")
            include(cmake/optional/optix.cmake)
        elseif(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "VULKAN")
            include(cmake/optional/vulkan.cmake)
        elseif(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "WEBGPU")
            include(cmake/optional/webgpu.cmake)
        elseif(RL_TOOLS_HYPERLUX_BACKEND_RESOLVED STREQUAL "GENERIC")
            include(cmake/optional/hyperlux_generic.cmake)
        endif()
        string(APPEND RL_TOOLS_SUMMARY_HYPERLUX_REASON ", Assimp FetchContent ${RL_TOOLS_ASSIMP_VERSION} (SHA256)")
        set(RL_TOOLS_ENABLE_HYPERLUX ON)
    endif()
else()
    set(RL_TOOLS_SUMMARY_HYPERLUX_REASON "disabled by RL_TOOLS_DISABLE_HYPERLUX")
endif()

# the wasm golden reference (tests/src/hyperlux/wasm): the generator as a WASI module, built with wasi-sdk and run under wasmtime
option(RL_TOOLS_HYPERLUX_ENABLE_WASM_GOLDENS "Enable the wasm golden reference module (downloads wasi-sdk and Wasmtime)" OFF)
set(RL_TOOLS_HYPERLUX_WASM_GOLDENS_AVAILABLE OFF)
if(NOT RL_TOOLS_HYPERLUX_ENABLE_WASM_GOLDENS)
    set(RL_TOOLS_SUMMARY_HYPERLUX_WASM_GOLDENS_REASON "opt in with RL_TOOLS_HYPERLUX_ENABLE_WASM_GOLDENS=ON")
elseif(RL_TOOLS_DISABLE_TESTS)
    set(RL_TOOLS_SUMMARY_HYPERLUX_WASM_GOLDENS_REASON "tests disabled")
elseif(RL_TOOLS_ENABLE_HYPERLUX)
    if(CMAKE_VERSION VERSION_LESS 3.25)
        set(RL_TOOLS_SUMMARY_HYPERLUX_WASM_GOLDENS_REASON "requires CMake 3.25")
    else()
        set(RL_TOOLS_GOLDEN_WASM_DEPENDENCIES_DIR "${FETCHCONTENT_BASE_DIR}/wasm")
        include("${PROJECT_SOURCE_DIR}/cmake/dependencies/wasm.cmake")
        rl_tools_fetch_wasm("${RL_TOOLS_GOLDEN_WASM_DEPENDENCIES_DIR}")
        if(RL_TOOLS_WASM_UNAVAILABLE_REASON)
            set(RL_TOOLS_SUMMARY_HYPERLUX_WASM_GOLDENS_REASON "${RL_TOOLS_WASM_UNAVAILABLE_REASON}")
        else()
            set(RL_TOOLS_HYPERLUX_WASM_GOLDENS_AVAILABLE ON)
            set(RL_TOOLS_SUMMARY_HYPERLUX_WASM_GOLDENS_REASON "${WASI_SDK_PREFIX}, ${RL_TOOLS_WASMTIME}")
        endif()
    endif()
endif()
