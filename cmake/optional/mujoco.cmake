if(NOT RL_TOOLS_RL_ENVIRONMENTS_DISABLE_MUJOCO)
    set(MUJOCO_BUILD_EXAMPLES OFF)
    set(MUJOCO_BUILD_SIMULATE OFF)
    set(MUJOCO_BUILD_TESTS OFF)
    set(MUJOCO_TEST_PYTHON_UTIL OFF)
    if(GIT_FOUND)
        if(POLICY CMP0135)
            cmake_policy(SET CMP0135 NEW)
        endif()
        FetchContent_Declare(mujoco
                URL https://github.com/google-deepmind/mujoco/archive/refs/tags/2.3.5.tar.gz
                URL_HASH SHA256=882d855d833375ad27adfa2d9cf4ec2381a1069ebe8fbc4578d876deb4e0b33f
        )
        rl_tools_fetchcontent_makeavailable_quiet(mujoco)
        # MuJoCo 2.3.5 hardcodes -Werror; its warning set predates current compilers (e.g. GCC 15)
        function(rl_tools_mujoco_strip_werror STRIP_DIRECTORY)
            get_property(RL_TOOLS_STRIP_TARGETS DIRECTORY ${STRIP_DIRECTORY} PROPERTY BUILDSYSTEM_TARGETS)
            foreach(RL_TOOLS_STRIP_TARGET IN LISTS RL_TOOLS_STRIP_TARGETS)
                get_target_property(RL_TOOLS_STRIP_OPTIONS ${RL_TOOLS_STRIP_TARGET} COMPILE_OPTIONS)
                if(RL_TOOLS_STRIP_OPTIONS AND "-Werror" IN_LIST RL_TOOLS_STRIP_OPTIONS)
                    list(REMOVE_ITEM RL_TOOLS_STRIP_OPTIONS "-Werror")
                    set_target_properties(${RL_TOOLS_STRIP_TARGET} PROPERTIES COMPILE_OPTIONS "${RL_TOOLS_STRIP_OPTIONS}")
                endif()
            endforeach()
            get_property(RL_TOOLS_STRIP_SUBDIRECTORIES DIRECTORY ${STRIP_DIRECTORY} PROPERTY SUBDIRECTORIES)
            foreach(RL_TOOLS_STRIP_SUBDIRECTORY IN LISTS RL_TOOLS_STRIP_SUBDIRECTORIES)
                rl_tools_mujoco_strip_werror(${RL_TOOLS_STRIP_SUBDIRECTORY})
            endforeach()
        endfunction()
        rl_tools_mujoco_strip_werror(${mujoco_SOURCE_DIR})
        set(RL_TOOLS_SUMMARY_MUJOCO_REASON "FetchContent 2.3.5")
    else()
        set(RL_TOOLS_SUMMARY_MUJOCO_REASON "no git")
    endif()
    if(TARGET mujoco::mujoco)
        set(RL_TOOLS_RL_ENVIRONMENTS_ENABLE_MUJOCO ON)
        target_link_libraries(rl_tools_full INTERFACE mujoco::mujoco)
        target_compile_definitions(rl_tools_full INTERFACE RL_TOOLS_RL_ENVIRONMENTS_ENABLE_MUJOCO)

        find_package(glfw3 QUIET)
        if(glfw3_FOUND)
            message(VERBOSE "Found existing/system glfw3 ${glfw3_VERSION} at ${glfw3_DIR}")
        elseif(GIT_FOUND)
            set(RL_TOOLS_MUJOCO_UI_BUILDABLE ON)
            if(UNIX AND NOT APPLE AND (NOT DEFINED GLFW_BUILD_X11 OR GLFW_BUILD_X11))
                find_package(X11 QUIET)
                if(NOT X11_FOUND)
                    set(RL_TOOLS_MUJOCO_UI_BUILDABLE OFF)
                    string(APPEND RL_TOOLS_SUMMARY_MUJOCO_REASON ", UI off (no X11 dev headers for glfw)")
                else()
                    set(RL_TOOLS_GLFW_MISSING_X11_HEADERS "")
                    foreach(RL_TOOLS_GLFW_X11_COMPONENT Xrandr Xinerama Xkb Xcursor Xi Xshape)
                        if(NOT X11_${RL_TOOLS_GLFW_X11_COMPONENT}_INCLUDE_PATH)
                            list(APPEND RL_TOOLS_GLFW_MISSING_X11_HEADERS ${RL_TOOLS_GLFW_X11_COMPONENT})
                        endif()
                    endforeach()
                    if(RL_TOOLS_GLFW_MISSING_X11_HEADERS)
                        set(RL_TOOLS_MUJOCO_UI_BUILDABLE OFF)
                        list(JOIN RL_TOOLS_GLFW_MISSING_X11_HEADERS ", " RL_TOOLS_GLFW_MISSING_X11_HEADERS)
                        string(APPEND RL_TOOLS_SUMMARY_MUJOCO_REASON ", UI off (missing glfw X11 headers: ${RL_TOOLS_GLFW_MISSING_X11_HEADERS})")
                    endif()
                endif()
            endif()
            if(RL_TOOLS_MUJOCO_UI_BUILDABLE)
                if(NOT DEFINED GLFW_BUILD_WAYLAND)
                    set(GLFW_BUILD_WAYLAND OFF)
                endif()
                FetchContent_Declare(glfw3
                        GIT_REPOSITORY https://github.com/glfw/glfw.git
                        GIT_TAG        3.4
                        GIT_SHALLOW    TRUE
                )
                rl_tools_fetchcontent_makeavailable_quiet(glfw3)
            endif()
        endif()
        if(glfw3_FOUND OR TARGET glfw)
            target_link_libraries(rl_tools_full INTERFACE glfw)
            set(RL_TOOLS_RL_ENVIRONMENTS_MUJOCO_ENABLE_UI ON)
            target_compile_definitions(rl_tools_full INTERFACE RL_TOOLS_RL_ENVIRONMENTS_MUJOCO_ENABLE_UI)
            string(APPEND RL_TOOLS_SUMMARY_MUJOCO_REASON ", UI on")
        elseif(NOT GIT_FOUND)
            string(APPEND RL_TOOLS_SUMMARY_MUJOCO_REASON ", UI off (glfw not found and no git)")
        endif()
    endif()
endif()
