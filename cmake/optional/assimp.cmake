include(cmake/dependencies/assimp.cmake)
if(NOT RL_TOOLS_OFFLINE_BUILD OR EXISTS "${RL_TOOLS_ASSIMP_ARCHIVE}" OR FETCHCONTENT_SOURCE_DIR_ASSIMP)
    function(rl_tools_fetch_assimp)
        set(BUILD_SHARED_LIBS OFF)
        set(ASSIMP_BUILD_TESTS OFF)
        set(ASSIMP_BUILD_ASSIMP_TOOLS OFF)
        set(ASSIMP_BUILD_SAMPLES OFF)
        set(ASSIMP_BUILD_USE_CCACHE OFF)
        set(ASSIMP_INSTALL OFF)
        set(ASSIMP_WARNINGS_AS_ERRORS OFF)
        set(ASSIMP_NO_EXPORT ON)
        set(ASSIMP_BUILD_ALL_IMPORTERS_BY_DEFAULT OFF)
        set(ASSIMP_BUILD_GLTF_IMPORTER ON)
        set(ASSIMP_BUILD_ZLIB ON)

        if(RL_TOOLS_ZLIB_TARGET)
            set(ZLIB_FOUND TRUE)
            set(ZLIB_LIBRARIES ${RL_TOOLS_ZLIB_TARGET})
            set(ZLIB_INCLUDE_DIR ${zlib_SOURCE_DIR} ${zlib_BINARY_DIR})
        else()
            find_package(ZLIB QUIET)
        endif()

        if(RL_TOOLS_OFFLINE_BUILD)
            set(FETCHCONTENT_FULLY_DISCONNECTED OFF)
        endif()
        rl_tools_fetchcontent_makeavailable_quiet(assimp)
    endfunction()
    rl_tools_fetch_assimp()
endif()
