bool output_enabled(uint slot){
    return (fc_output_mask & (1u << slot)) != 0u;
}
vec3 hue_to_rgb(float hue){
    const float descending = 1.0 - abs((hue - 2.0 * floor(hue * 0.5)) - 1.0);
    switch(uint(hue) % 6u){
        case 0u: { return vec3(1.0, descending, 0.0); }
        case 1u: { return vec3(descending, 1.0, 0.0); }
        case 2u: { return vec3(0.0, 1.0, descending); }
        case 3u: { return vec3(0.0, descending, 1.0); }
        case 4u: { return vec3(descending, 0.0, 1.0); }
        default: { return vec3(1.0, 0.0, descending); }
    }
}
uint pack_color(uvec3 rgb){
    return 0xFF000000u | (rgb.z << 16u) | (rgb.y << 8u) | rgb.x;
}
uint segmentation_id_to_rgba(uint id){
    if(id == 0xFFFFFFFFu){
        return 0xFF000000u;
    }
    const float scaled = float(id) * 0.61803398875;
    const float hue = (scaled - floor(scaled)) * 6.0;
    return pack_color(uvec3(hue_to_rgb(hue) * 255.0));
}
// Match the CPU encoder's f32 product followed by its f64 half-up bias.
uint normal_channel(float n){
    const uint unit_bits = floatBitsToUint(clamp(n, -1.0, 1.0) * 0.5 + 0.5);
    if(unit_bits < 0x3B000000u){
        return 0u;
    }
    const uint product = ((unit_bits & 0x7FFFFFu) | 0x800000u) * 255u;
    const uint shift = product >= 0x80000000u ? 8u : 7u;
    const uint whole = product >> shift;
    const uint remainder = product & ((1u << shift) - 1u);
    const uint midpoint = 1u << (shift - 1u);
    const bool round_up = remainder > midpoint || (remainder == midpoint && (whole & 1u) != 0u);
    const uint rounded = whole + (round_up ? 1u : 0u);
    const uint integer_shift = 150u - (unit_bits >> 23u) - shift;
    return (rounded + (1u << (integer_shift - 1u))) >> integer_shift;
}
uint normal_to_rgba(vec3 normal){
    return pack_color(uvec3(normal_channel(normal.x), normal_channel(normal.y), normal_channel(normal.z)));
}
uint flow_to_rgba(vec2 flow, float magnitude_scale){
    if(all(equal(flow, vec2(0.0))) || magnitude_scale <= 0.0){
        return 0xFFFFFFFFu;
    }
    const float magnitude = sqrt(flow.x * flow.x + flow.y * flow.y);
    const float saturation = min(magnitude / magnitude_scale, 1.0);
    float angle = atan(flow.y, flow.x);
    if(flow.x == 0.0){
        angle = flow.y > 0.0 ? 1.57079632679489661923 : -1.57079632679489661923;
    }
    const float hue = (angle / 6.28318530717958647692 + 0.5) * 6.0;
    return pack_color(uvec3((vec3(1.0) - saturation * (vec3(1.0) - hue_to_rgb(hue))) * 255.0));
}
uint flow_status_to_rgba(uint status){
    switch(status){
        case 0u: { return 0xFFFFFFFFu; }
        case 1u: { return 0xFF000000u; }
        case 2u: { return 0xFFFF00FFu; }
        case 3u: { return 0xFFFF4020u; }
        case 4u: { return 0xFF0090FFu; }
        default: { return 0xFF0000FFu; }
    }
}
uint depth_to_rgba(float depth, float depth_scale){
    return pack_color(uvec3(uint(clamp(depth / depth_scale, 0.0, 1.0) * 255.0)));
}

