vec3 transform_point_to_world(int instance, vec3 p){
    const float m[12] = instance_data[instance].object_to_world;
    return vec3(m[0]*p.x + m[1]*p.y + m[2]*p.z + m[3],
                m[4]*p.x + m[5]*p.y + m[6]*p.z + m[7],
                m[8]*p.x + m[9]*p.y + m[10]*p.z + m[11]);
}
