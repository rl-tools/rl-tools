// normals transform with the inverse-transpose: multiply by the world_to_object columns
vec3 transform_normal_to_world(int instance, vec3 n){
    const float m[12] = instance_data[instance].world_to_object;
    return vec3(m[0]*n.x + m[4]*n.y + m[8]*n.z,
                m[1]*n.x + m[5]*n.y + m[9]*n.z,
                m[2]*n.x + m[6]*n.y + m[10]*n.z);
}
