#if defined(ENTRY_COLLISION)
void main(){
    const int cam_idx = int(gl_GlobalInvocationID.x);
    const int probe_idx = int(gl_GlobalInvocationID.y);

    if(cam_idx >= int(params.num_cameras) || probe_idx >= int(params.num_probes)){
        return;
    }
    const uint row = fc_all_cameras ? uint(cam_idx) : camera_table[uint(cam_idx) * CAMERA_TABLE_STRIDE + 1u + OUTPUT_PROBES];
    if(row == NO_ROW){
        return;
    }

    Camera cam = cameras_close[cam_idx];

    const vec3 forward = normalize(camera_dir_00(cam) + 0.5 * camera_dir_du(cam) + 0.5 * camera_dir_dv(cam));
    vec3 dir;
    if(probe_idx == 0){
        dir = forward;
    }
    else{
        const vec3 local = vec3(probe_directions[3 * probe_idx], probe_directions[3 * probe_idx + 1], probe_directions[3 * probe_idx + 2]);
        const vec3 left = -normalize(camera_dir_du(cam));
        const vec3 up = -normalize(camera_dir_dv(cam));
        dir = normalize(local.x * forward + local.y * left + local.z * up);
    }

    Hit hit = intersect_composed(cam_idx, camera_pos(cam), dir, 1e-3, params.max_dist, false);

    CollisionResult result;
    if(!hit.valid){
        result.distance = uintBitsToFloat(0x7f800000u);
        result.hit = 0;
    }
    else{
        result.distance = hit.t;
        result.hit = 1;
    }
    const uint offset = params.output_offsets[OUTPUT_PROBES] + 2u * (row * params.num_probes + uint(probe_idx));
    outputs[offset] = floatBitsToUint(result.distance);
    outputs[offset + 1u] = uint(result.hit);
}
#endif

#if defined(ENTRY_AUXILIARY) || defined(ENTRY_FLOW_FORWARD)
// FlowStatus codes (rl_tools/rendering/raytracing/types.h)
const uint FLOW_STATUS_VALID = 0u;
const uint FLOW_STATUS_MISS = 1u;
const uint FLOW_STATUS_BEHIND = 2u;
const uint FLOW_STATUS_OUT_OF_FRAME = 3u;
const uint FLOW_STATUS_OCCLUDED = 4u;
const float FLOW_VISIBILITY_EPSILON = 1e-4;
#if defined(ENTRY_FLOW_FORWARD)
const bool SOURCE_PREVIOUS = true;
#else
const bool SOURCE_PREVIOUS = false;
#endif

vec3 apply_flow_delta(uint base, vec3 p){
    return vec3(
        flow_deltas[base + 0]*p.x + flow_deltas[base + 1]*p.y + flow_deltas[base + 2]*p.z + flow_deltas[base + 3],
        flow_deltas[base + 4]*p.x + flow_deltas[base + 5]*p.y + flow_deltas[base + 6]*p.z + flow_deltas[base + 7],
        flow_deltas[base + 8]*p.x + flow_deltas[base + 9]*p.y + flow_deltas[base + 10]*p.z + flow_deltas[base + 11]);
}

// intersect_composed against one instant's overlay set: the current one (overlay_tlas) or the
// previous one (overlay_tlas_previous, flow only)
Hit intersect_composed_instant(bool previous, int camera, vec3 origin, vec3 direction, float tmin, float tmax, bool accept_any){
    const uint flags = accept_any ? (gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT) : gl_RayFlagsOpaqueEXT;
    Hit best = trace_single(tlas, origin, direction, tmin, tmax, flags);
    for(int k = 0; k < fc_overlay_count; k++){
        if(accept_any && best.valid){
            return best;
        }
        const uint overlay = overlay_attachments[camera * fc_overlay_count + k];
        if(overlay == 0xFFFFFFFFu){ continue; }
        const uint num_active = previous ? overlay_num_active_previous[overlay] : overlay_num_active[overlay];
        if(num_active == 0u){ continue; }
        const float clamped_tmax = best.valid ? best.t : tmax;
        Hit hit;
        if(previous){
            hit = trace_single(overlay_tlas_previous[nonuniformEXT(overlay)], origin, direction, tmin, clamped_tmax, flags);
        }
        else{
            hit = trace_single(overlay_tlas[nonuniformEXT(overlay)], origin, direction, tmin, clamped_tmax, flags);
        }
        if(hit.valid && (!best.valid || hit.t < best.t)){
            best = hit;
        }
    }
    return best;
}

// world point → screen fraction through the linear camera model: solves
// dir_00 + screen_x·dir_du + screen_y·dir_dv = lambda·(point − pos) by Cramer's rule;
// returns false for a degenerate basis or a point at/behind the camera (lambda <= 0)
bool project_camera(Camera cam, vec3 point, out float screen_x, out float screen_y){
    const vec3 direction = point - camera_pos(cam);
    const vec3 dir_du = camera_dir_du(cam);
    const vec3 dir_dv = camera_dir_dv(cam);
    const vec3 negative_direction = -direction;
    const vec3 cross_dv_negative_direction = cross(dir_dv, negative_direction);
    const float det = dot(dir_du, cross_dv_negative_direction);
    if(det > -1e-12 && det < 1e-12){
        return false;
    }
    const float inv_det = 1.0 / det;
    const vec3 b = -camera_dir_00(cam);
    screen_x = dot(b, cross_dv_negative_direction) * inv_det;
    screen_y = dot(dir_du, cross(b, negative_direction)) * inv_det;
    const float lambda = dot(dir_du, cross(dir_dv, b)) * inv_det;
    return lambda > 0.0;
}

// two-instant flow, one direction per entry point (mirror of the generic render_flow_frame):
// single-sample from the source pixel centre against the source instant; the hit point is
// carried to the target instant by its slot's delta, projected through the target camera, and
// tested for visibility from the target camera against the target instant with the relative
// margin FLOW_VISIBILITY_EPSILON. Status priority MISS, BEHIND, OUT_OF_FRAME, OCCLUDED, VALID;
// the vector is zero for MISS and BEHIND and the geometric flow otherwise
void write_flow(PixelLaunchContext ctx, Camera cam, vec3 direction, Hit hit){
    Camera cam_target = SOURCE_PREVIOUS ? cameras_close[ctx.cam_idx] : cameras_previous[ctx.cam_idx];
    const uint source_first_overlay_instance = params.first_overlay_instance + (SOURCE_PREVIOUS ? params.num_overlay_slots * (1u + (fc_dynamic_motion_blur ? uint(fc_motion_samples) : 0u)) : 0u);
    const uint delta_slab = SOURCE_PREVIOUS ? params.num_overlay_slots * 12u : 0u;
    vec2 flow = vec2(0.0);
    uint status = FLOW_STATUS_MISS;
    if(hit.valid){
        vec3 point = camera_pos(cam) + direction * hit.t;
        if(fc_overlay_count > 0 && uint(hit.instance_id) >= source_first_overlay_instance){
            point = apply_flow_delta(delta_slab + (uint(hit.instance_id) - source_first_overlay_instance) * 12u, point);
        }
        float target_x;
        float target_y;
        if(!project_camera(cam_target, point, target_x, target_y)){
            status = FLOW_STATUS_BEHIND;
        }
        else{
            flow = vec2(target_x * float(params.cam_width) - (float(ctx.local_x) + 0.5),
                        target_y * float(params.cam_height) - (float(ctx.local_y) + 0.5));
            if(target_x < 0.0 || target_x >= 1.0 || target_y < 0.0 || target_y >= 1.0){
                status = FLOW_STATUS_OUT_OF_FRAME;
            }
            else if((ctx.outputs & (SOURCE_PREVIOUS ? FLOW_FORWARD_VISIBILITY_SLOTS : FLOW_BACKWARD_VISIBILITY_SLOTS)) != 0u){
                const vec3 to_point = point - camera_pos(cam_target);
                const float len = length(to_point);
                const vec3 visibility_direction = to_point * (1.0 / len);
                Hit occluder = intersect_composed_instant(!SOURCE_PREVIOUS, ctx.cam_idx, camera_pos(cam_target), visibility_direction, 0.0, len * (1.0 - FLOW_VISIBILITY_EPSILON), true);
                status = occluder.valid ? FLOW_STATUS_OCCLUDED : FLOW_STATUS_VALID;
            }
        }
    }
    const uint flow_slot = SOURCE_PREVIOUS ? OUTPUT_FLOW_FORWARD_FLOAT32 : OUTPUT_FLOW_FLOAT32;
    const uint color_slot = SOURCE_PREVIOUS ? OUTPUT_FLOW_FORWARD_RGBA8 : OUTPUT_FLOW_RGBA8;
    const uint status_slot = SOURCE_PREVIOUS ? OUTPUT_FLOW_FORWARD_STATUS_UINT32 : OUTPUT_FLOW_STATUS_UINT32;
    const uint status_color_slot = SOURCE_PREVIOUS ? OUTPUT_FLOW_FORWARD_STATUS_RGBA8 : OUTPUT_FLOW_STATUS_RGBA8;
    if(output_selected(ctx, flow_slot)){
        outputs[params.output_offsets[flow_slot] + output_element(ctx, flow_slot) * 2] = floatBitsToUint(flow.x);
        outputs[params.output_offsets[flow_slot] + output_element(ctx, flow_slot) * 2 + 1] = floatBitsToUint(flow.y);
    }
    if(output_selected(ctx, color_slot)){
        outputs[params.output_offsets[color_slot] + output_element(ctx, color_slot)] = status == FLOW_STATUS_VALID ? flow_to_rgba(flow, params.output_scales[color_slot]) : flow_status_to_rgba(status);
    }
    if(output_selected(ctx, status_slot)){
        outputs[params.output_offsets[status_slot] + output_element(ctx, status_slot)] = status;
    }
    if(output_selected(ctx, status_color_slot)){
        outputs[params.output_offsets[status_color_slot] + output_element(ctx, status_color_slot)] = flow_status_to_rgba(status);
    }
}
#if defined(ENTRY_FLOW_FORWARD)
void main(){
    PixelLaunchContext ctx = pixel_launch_context(gl_GlobalInvocationID.xy);
    ctx.outputs &= fc_output_mask;
    if((ctx.outputs & FLOW_FORWARD_SLOTS) == 0u){
        return;
    }
    Camera cam = cameras_previous[ctx.cam_idx];
    const vec2 screen = (vec2(ctx.local_x, ctx.local_y) + vec2(0.5, 0.5)) / vec2(params.cam_width, params.cam_height);
    const vec3 direction = normalize(camera_dir_00(cam) + screen.x * camera_dir_du(cam) + screen.y * camera_dir_dv(cam));
    Hit hit = intersect_composed_instant(true, ctx.cam_idx, camera_pos(cam), direction, 0.0, 1e30, false);
    write_flow(ctx, cam, direction, hit);
}
#endif
#endif

#if defined(ENTRY_AUXILIARY)
void write_depth(PixelLaunchContext ctx, Camera cam, vec3 direction, Hit hit){
    const vec3 normal = normalize(cross(camera_dir_du(cam), camera_dir_dv(cam)));
    const float depth = hit.valid ? hit.t * abs(dot(direction, normal)) : uintBitsToFloat(0x7f800000u);
    if(output_selected(ctx, OUTPUT_DEPTH_FLOAT32)){
        outputs[params.output_offsets[OUTPUT_DEPTH_FLOAT32] + output_element(ctx, OUTPUT_DEPTH_FLOAT32)] = floatBitsToUint(depth);
    }
    if(output_selected(ctx, OUTPUT_DEPTH_RGBA8)){
        outputs[params.output_offsets[OUTPUT_DEPTH_RGBA8] + output_element(ctx, OUTPUT_DEPTH_RGBA8)] = depth_to_rgba(depth, params.output_scales[OUTPUT_DEPTH_RGBA8]);
    }
}
void write_segmentation(PixelLaunchContext ctx, Hit hit){
    const uint instance = hit.valid ? uint(hit.instance_id) : 0xFFFFFFFFu;
    if(output_selected(ctx, OUTPUT_SEGMENTATION_UINT32)){
        outputs[params.output_offsets[OUTPUT_SEGMENTATION_UINT32] + output_element(ctx, OUTPUT_SEGMENTATION_UINT32)] = instance;
    }
    if(output_selected(ctx, OUTPUT_SEGMENTATION_RGBA8)){
        outputs[params.output_offsets[OUTPUT_SEGMENTATION_RGBA8] + output_element(ctx, OUTPUT_SEGMENTATION_RGBA8)] = segmentation_id_to_rgba(instance);
    }
    if(output_selected(ctx, OUTPUT_SEMANTIC_UINT32) || output_selected(ctx, OUTPUT_SEMANTIC_RGBA8)){
        const uint semantic = hit.valid ? instance_classes[uint(hit.instance_id)] : 0xFFFFFFFFu;
        if(output_selected(ctx, OUTPUT_SEMANTIC_UINT32)){
            outputs[params.output_offsets[OUTPUT_SEMANTIC_UINT32] + output_element(ctx, OUTPUT_SEMANTIC_UINT32)] = semantic;
        }
        if(output_selected(ctx, OUTPUT_SEMANTIC_RGBA8)){
            outputs[params.output_offsets[OUTPUT_SEMANTIC_RGBA8] + output_element(ctx, OUTPUT_SEMANTIC_RGBA8)] = segmentation_id_to_rgba(semantic);
        }
    }
}
void write_normals(PixelLaunchContext ctx, vec3 direction, Hit hit){
    vec3 normal = vec3(0.0);
    if(hit.valid){
        const int mesh = int(instance_record_base[hit.instance_id]) + hit.geometry_index;
        const ivec3 index = fetch_index(mesh, hit.primitive_index);
        vec3 vertex_a = fetch_vertex(mesh, index.x);
        vec3 vertex_b = fetch_vertex(mesh, index.y);
        vec3 vertex_c = fetch_vertex(mesh, index.z);
        if(instance_data[hit.instance_id].identity == 0u){
            vertex_a = transform_point_to_world(hit.instance_id, vertex_a);
            vertex_b = transform_point_to_world(hit.instance_id, vertex_b);
            vertex_c = transform_point_to_world(hit.instance_id, vertex_c);
        }
        normal = normalize(cross(vertex_b - vertex_a, vertex_c - vertex_a));
        if(dot(direction, normal) > 0.0){
            normal = -normal;
        }
    }
    if(output_selected(ctx, OUTPUT_NORMALS_FLOAT32)){
        outputs[params.output_offsets[OUTPUT_NORMALS_FLOAT32] + output_element(ctx, OUTPUT_NORMALS_FLOAT32) * 3] = floatBitsToUint(normal.x);
        outputs[params.output_offsets[OUTPUT_NORMALS_FLOAT32] + output_element(ctx, OUTPUT_NORMALS_FLOAT32) * 3 + 1] = floatBitsToUint(normal.y);
        outputs[params.output_offsets[OUTPUT_NORMALS_FLOAT32] + output_element(ctx, OUTPUT_NORMALS_FLOAT32) * 3 + 2] = floatBitsToUint(normal.z);
    }
    if(output_selected(ctx, OUTPUT_NORMALS_RGBA8)){
        outputs[params.output_offsets[OUTPUT_NORMALS_RGBA8] + output_element(ctx, OUTPUT_NORMALS_RGBA8)] = normal_to_rgba(normal);
    }
}
void main(){
    PixelLaunchContext ctx = pixel_launch_context(gl_GlobalInvocationID.xy);
    ctx.outputs &= fc_output_mask;
    if((ctx.outputs & (DEPTH_SLOTS | SEGMENTATION_SLOTS | NORMALS_SLOTS | FLOW_BACKWARD_SLOTS)) == 0u){
        return;
    }
    Camera cam = cameras_close[ctx.cam_idx];
    const vec2 screen = (vec2(ctx.local_x, ctx.local_y) + vec2(0.5, 0.5)) / vec2(params.cam_width, params.cam_height);
    const vec3 direction = normalize(camera_dir_00(cam) + screen.x * camera_dir_du(cam) + screen.y * camera_dir_dv(cam));
    Hit hit = intersect_composed(ctx.cam_idx, camera_pos(cam), direction, 0.0, 1e30, false);
    if((ctx.outputs & DEPTH_SLOTS) != 0u){
        write_depth(ctx, cam, direction, hit);
    }
    if((ctx.outputs & SEGMENTATION_SLOTS) != 0u){
        write_segmentation(ctx, hit);
    }
    if((ctx.outputs & NORMALS_SLOTS) != 0u){
        write_normals(ctx, direction, hit);
    }
    if((ctx.outputs & FLOW_BACKWARD_SLOTS) != 0u){
        write_flow(ctx, cam, direction, hit);
    }
}
#endif
